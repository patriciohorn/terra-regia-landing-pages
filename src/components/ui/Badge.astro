---
import { cn } from "../../lib/utils"
import { cva } from "class-variance-authority"

const variants = {
  variant: {
    size: {
      md: '', 
      lg: ''
    }
  }
}

const badgeVariants = cva("inline-flex items-center justify-center bg-neutral-50 text-neutral-700 text-sm font-medium rounded-full border border-neutral-200 shadow-xs", {
  variants: {
    size: {
      md: "px-2.5 py-[2px]", 
      lg: "px-3 py-1"
    }
  }, 
  defaultVariants: {
    size: "lg"
  }
})

const {size} = Astro.props
---


<span class={cn(badgeVariants({size}))}>
  <slot/>
</span>