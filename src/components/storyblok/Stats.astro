---
import { Image } from "astro:assets";
import { sbImage, sbSrcSet } from "../../lib/storyblokImage";
import StatItem from "./StatItem.astro";
const { blok } = Astro.props;
const bgImage = blok.bg_image?.filename;
---

<section class="py-16 sm:py-28 bg-brand-50">
  <div class="section-container">
    <div
      class="relative rounded-3xl overflow-hidden px-16 py-28 flex flex-col gap-y-20"
    >
      <img
        src={sbImage(bgImage, 1600)}
        srcset={sbSrcSet(bgImage)}
        class="absolute inset-0 w-full h-full object-center object-cover"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 w-full h-full bg-black/30"></div>
      <div class="relative z-10 flex justify-between">
        <div class="flex flex-col w-138">
          <p class="text-lg text-neutral-50">{blok.eyebrow}</p>
          <Image src={blok.logo.filename} alt="" width="240" height="60" />
        </div>
        <p class="text-lg text-neutral-50 max-w-138">{blok.description}</p>
      </div>
      <div class="relative z-10 flex gap-x-12">
        {
          blok.stats.map((stat: any) => (
            <StatItem value={stat.value} label={stat.label} />
          ))
        }
      </div>
    </div>
  </div>
</section>
