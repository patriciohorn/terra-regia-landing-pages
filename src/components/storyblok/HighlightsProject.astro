---
import HighlightItem from "./HighlightItem.astro";

const { blok } = Astro.props;
---

<section class="py-16 sm:py-28 bg-brand-50">
  <div class="section-container space-y-12 sm:space-y-20">
    <div class="flex flex-col items-center gap-3 sm:gap-4">
      <p class="uppercase text-sm font-medium tracking-wide text-brand-500">
        {blok.eyebrow}
      </p>
      <h2
        class="text-4xl sm:text-5xl leading-[1.1] font-regular max-w-3xl mx-auto text-center text-neutral-950"
      >
        {blok.headline}
      </h2>
    </div>
    <div class="grid sm:grid-cols-3 gap-12">
      {blok.highlights.map((item: any) => <HighlightItem blok={item} />)}
    </div>
  </div>
</section>
