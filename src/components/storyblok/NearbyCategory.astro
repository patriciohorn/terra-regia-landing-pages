---
interface NearbyPlaces {
  name: string;
  time: string;
}
import UbicacionIcon from "@components/ui/icons/UbicacionIcon.astro";
import NearbyPlaces from "./NearbyPlaces.astro";

const { blok } = Astro.props;
---

<div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
  <UbicacionIcon label={blok.label} />
  <div class="sm:mt-2.5 space-y-2 sm:space-y-4">
    <h3 class="lg:text-lg text-xl font-medium">{blok.label}</h3>
    <div class="flex flex-col gap-1.5 sm:gap-2">
      {
        blok.places.map(({ name, time }: NearbyPlaces) => (
          <NearbyPlaces name={name} time={time} />
        ))
      }
    </div>
  </div>
</div>
