---
import { Image } from "astro:assets";
// import { Icon } from "astro-icon/components";

import terraRegiaLogo from "../../assets/logo-terra-regia-white.svg";
import { getSiteConfig } from "../../lib/siteConfig";
import Facebook from "../ui/icons/Facebook.astro";
import Instagram from "../ui/icons/Instagram.astro";
import LinkedIn from "../ui/icons/LinkedIn.astro";
import Youtube from "../ui/icons/Youtube.astro";

interface Props {
  projectName?: string;
  email?: string;
  phone?: string;
  hours?: string;
  address?: string;
  mapsUrl?: string;
}

const socialLinks = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/rincondelasierraresidencial/",
    icon: "instagram",
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/rincondelasierradominiocumbres",
    icon: "facebook",
  },
  {
    name: "YouTube",
    href: "https://www.youtube.com/watch?v=8sKeipuqvhk&t=1s",
    icon: "youtube",
  },
].filter((social) => social.href);

const linkClass =
  "text-sm hover:underline transition-colors hover:decoration-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white";

const site = getSiteConfig();
const projectLogo = site.logo_light.filename;
const phoneLabel = site.whatsapp.split("").slice(2).join("");
const {
  projectName = "Rincón de la Sierra",
  email = "ventas@terraregia.com",
  phone = phoneLabel,
  hours = "Lun-Dom: 9:00 am – 7:00 pm",
  address = "Dominio Cumbres, Nuevo León, México 66036",
  mapsUrl = "https://maps.gooe.com/?q=Dominio+Cumbres+Nuevo+Leon",
} = Astro.props;
console.log("SITEEEE", site);
---

<footer class="rounded-tl-3xl rounded-tr-3xl bg-brand-900 text-white">
  <div class="mx-auto max-w-352 px-6 py-14 md:px-16 md:py-20">
    <!-- Top: brand block + contact columns -->
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-20">
      <div>
        <Image
          src={projectLogo}
          alt={`Logo ${projectName}`}
          width={320}
          height={130}
          class="h-auto w-56 md:w-[160px]"
        />

        <div class="mt-10 space-y-4 text-sm md:text-base">
          <p class="font-medium">Visita nuestra oficina de ventas:</p>
          <p class="text-neutral-200">{address}</p>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}
          >
            Abrir en maps
          </a>
        </div>
      </div>

      <dl
        class="grid gap-x-12 gap-y-8 self-start text-sm sm:grid-cols-3 md:gap-x-16 md:text-base"
      >
        <div class="space-y-2">
          <dt class="font-medium">Correo electrónico</dt>
          <dd>
            <a href={`mailto:${email}`} class={linkClass}>{email}</a>
          </dd>
        </div>

        <div class="space-y-2">
          <dt class="font-medium">Teléfono</dt>
          <dd>
            <a href={`tel:${phone.replace(/\D/g, "")}`} class={linkClass}>
              {phone}
            </a>
          </dd>
        </div>

        <div class="space-y-2">
          <dt class="font-medium">Horario de atención</dt>
          <dd class="text-sm text-neutral-200">{hours}</dd>
        </div>
      </dl>
    </div>

    <!-- Bottom: corporate wordmark + socials -->

    <div
      class="mt-16 flex flex-col gap-8 md:mt-24 md:flex-row md:items-center md:justify-between"
    >
      <div class="h-[0.5px] bg-brand-200 w-full"></div>
      <a href="https://terraregia.com" aria-label="Terra Regia">
        <Image
          src={terraRegiaLogo}
          alt="Terra Regia"
          width={160}
          height={40}
          class="h-auto w-32 md:w-40"
        />
      </a>

      <!-- <ul class="flex items-center gap-5">
        <div class="flex items-center gap-4">
          <a
            ><svg
              role="img"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              ><title>Facebook</title><path
                d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"
              ></path></svg
            ></a
          >
        </div>
      </ul> -->
    </div>
  </div>
</footer>
