---
const { blok } = Astro.props;
---

<div class="p-4">
  <div class="flex gap-4 items-center">
    <div class={`bg-blue-500 rounded-sm w-5 h-5 shrink-0`}></div>
    <div class="flex justify-between w-full">
      <div class="flex flex-col gap-1">
        <p class="text-base font-medium">{blok.name}</p>
        <p class="text-sm text-neutral-500">{blok.availability}</p>
      </div>
      <div class="flex flex-col gap-1">
        <p class="text-base font-medium">{blok.price}</p>
        <p class="text-sm text-neutral-500">{blok.supporting_label}</p>
      </div>
    </div>
  </div>
</div>
