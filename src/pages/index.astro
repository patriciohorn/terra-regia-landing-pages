---
// import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import Layout from "../layouts/Layout.astro";
import { getStory } from "../lib/storyblok";
import { resolveSite } from "../config/sites";
import { setSiteConfig } from "../lib/siteConfig";

const site = resolveSite();
const [story, configStory] = await Promise.all([
  getStory(`${site.key}/home`),
  getStory(`${site.key}/site-config`),
]);

const siteConfig = configStory.content;
setSiteConfig(siteConfig);
---

<Layout>
  <StoryblokComponent blok={story.content} />
</Layout>
